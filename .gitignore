# ==============================================================================
# .gitignore — 正式文件（代码 / 文档 / 数据清单 / 汇总表）一律入库
#              仅忽略可重建的环境、体积巨大的运行期产物、Agent 工作区
# ==============================================================================

# ---- 运行环境（可重建）----
.venv/
venv/
env/
app/frontend/node_modules/
app/frontend/dist/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行期产物 ----
# 默认忽略全部批次；仅放行经审计验收的权威批次 ultimate_run（论文/答辩唯一结果来源）。
# 注意：必须先忽略目录内容再反向放行，否则 git 无法重新包含被忽略目录内的路径。
results/batches/*
!results/batches/ultimate_run/
results/logs/*
!results/logs/ultimate_run/
models/weights/*
!models/weights/ultimate_run/
output/

# ---- Agent / 开发工作区（与正式交付物隔离）----
workspace/projects/
workspace/runs/
workspace/qc_sessions/
workspace/agent/
workspace/cache/
workspace/scratch/
workspace/temporary/
workspace/environments/
workspace/archive/
workspace/credentials/

# ---- 打包/临时文件 ----
*.tar.gz
*.zip
.DS_Store
Thumbs.db
_no_upload/

# ---- LaTeX 编译中间产物（论文正式 PDF 见 docs/paper/main/main.pdf）----
*.aux
*.log
*.out
*.blg
*.bbl
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb

# 训练日志属于实验结果，不受上面 LaTeX 产物 *.log 规则影响（后面的规则优先）
!results/logs/**/*.log

# ---- HPC 上传包（派生目录，由 deploy/hpc/make_upload_dir.sh 生成）----
# 它复制了 core/workflows 与 data/processed/<数据集>/，体积约 67 MB；
# 源码与数据在仓库里已有唯一权威副本，不需要把包本身纳入版本控制。
/upload/
# 上面的 upload/ 目录的单文件打包（便于 scp/rsync）
/upload.tar.gz

# ---- 第三方软件运行环境（CRISPRon / CRISPRoff）----
# 原始包与依赖 tar.gz 已归档在 deploy/external/crispron/package/ 与 dependencies/，
# 其 checksum 记录在同目录 SHA256SUMS.txt；解压实例与隔离 venv 体积大且可重建，
# 因此不入版本控制（重建方式见 deploy/external/crispron/INSTALL_NOTES.md）。
deploy/external/crispron/venv/
deploy/external/crispron/software/
deploy/external/crispron/dependencies/crisproff-1.1.2/
