# ==============================================================================
# .gitignore — 正式文件（代码 / 文档 / 数据清单 / 汇总表）一律入库
#              仅忽略可重建的环境、体积巨大的运行期产物、Agent 工作区
# ==============================================================================

# ---- 运行环境（可重建）----
.venv/
venv/
env/
app/frontend/node_modules/
app/frontend/dist/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 运行期产物（体积大，本地保留，按需回传）----
results/batches/
results/logs/
models/weights/
output/

# ---- Agent / 开发工作区（与正式交付物隔离）----
workspace/projects/
workspace/runs/
workspace/qc_sessions/
workspace/agent/
workspace/cache/
workspace/scratch/
workspace/temporary/
workspace/environments/
workspace/archive/
workspace/credentials/

# ---- 打包/临时文件 ----
*.tar.gz
*.zip
.DS_Store
Thumbs.db
_no_upload/

# ---- LaTeX 编译中间产物（论文正式 PDF 见 docs/paper/main/main.pdf）----
*.aux
*.log
*.out
*.blg
*.bbl
*.xdv
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.nav
*.snm
*.vrb
